@startuml
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Context.puml
LAYOUT_TOP_DOWN()
title C4‑L1: Контекст — Открытие депозитов онлайн (MVP)

' === КЛИЕНТЫ И ПОЛЬЗОВАТЕЛИ (НАВЕРХУ) ===
together {
  Person(newClient, "Клиент (новый)", "Подаёт заявку через сайт")
  Person(existingClient, "Клиент (действующий)", "Оформляет депозит в интернет‑банке")
  Person(operator, "Оператор кол‑центра", "Работает в CRM")
}

' === ВНУТРЕННИЕ СИСТЕМЫ (ГРУППИРОВКА) ===
together {
  System(web, "Сайт (Public Web)", "", "Форма заявки, список актуальных ставок")
  System(ib, "Интернет‑банк", "", "Персонализированные ставки, заявка, СМС‑подтверждение")
  System(iam, "IAM/SSO", "", "Централизованная аутентификация/авторизация, OIDC/OAuth2, единые политики")
}

together {
  System(crm, "Кол‑центр (CRM)", "", "Обработка обращений клиентов")
  System(abs, "АБС", "", "Учёт счетов/депозитов, договоры, расчёт/подтверждение")
}

' === ВНЕШНИЕ СИСТЕМЫ (ГРУППИРОВКА) ===
together {
  System_Ext(sms, "СМС‑шлюз", "", "Отправка СМС‑уведомлений")
  System_Ext(excel, "Excel (ставки)", "", "Ручной расчёт/хранение ставок (as‑is)")
}

' === ВЗАИМОДЕЙСТВИЯ ===

' Связи человек → система
Rel(newClient, web, "Выбор депозита и подача заявки", "HTTPS/TLS")
Rel(existingClient, ib, "Просмотр ставок, заявка, СМС‑подтверждение", "HTTPS/TLS")
Rel(operator, crm, "Звонок клиенту, работа с обращениями")

' Аутентификация через IAM/SSO
Rel(newClient, iam, "Аутентификация (для зарегистрированных)", "OIDC/OAuth2")
Rel(existingClient, iam, "Единый вход в систему", "OIDC/OAuth2")

' Связи система → система (только high‑level)
Rel(web, iam, "Проверка аутентификации", "OIDC/JWT")
Rel(ib, iam, "Единый вход и авторизация", "OIDC/JWT")
Rel(web, crm, "Передача заявки/лида", "REST/TLS")
Rel(crm, abs, "Создание/уточнение заявки", "Интеграция")
Rel(ib, abs, "Передача заявки", "REST/интеграция")

Rel(abs, sms, "Уведомления о ставке/открытии", "SMS API")
Rel(sms, newClient, "SMS")
Rel(sms, existingClient, "SMS")

Rel(abs, excel, "Импорт/экспорт ставок (ручной обмен)")

@enduml