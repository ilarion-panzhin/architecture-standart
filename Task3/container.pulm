@startuml
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Container.puml
LAYOUT_TOP_DOWN()
title C4-L2: Контейнеры — Интернет-банк, АБС и интеграции (MVP)

' === ГРУППИРОВКА ПЕРСОН ===
together {
  Person(newClient, "Клиент (новый)", "Через сайт")
  Person(existingClient, "Клиент (действующий)", "Через интернет-банк")
  Person(operCC, "Оператор кол-центра", "Работа в CRM")
}

' === ГРУППИРОВКА СИСТЕМ ===
System_Boundary(dc, "Цифровые каналы") {
  together {
    System(web, "Сайт (Public Web)", "TLS", "Форма заявки, показ ставок")
    
    Container(ib_ui, "IB Web UI", "ASP.NET MVC 4.5", "UI: выбор депозита, сумма, СМС-подтверждение")
    Container(ib_be, "IB Backend (монолит)", ".NET Framework", "Бизнес-логика заявок, валидация, аудит")
    ContainerDb(ib_db, "IB DB", "MS SQL", "Заявки, справочники, outbox (если используется)")
  }
  
  ' опционально IAM/SSO для полноты
  Container_Ext(iam, "IAM/SSO (опционально)", "OIDC/OAuth2", "Единая аутентификация")
}

System_Boundary(reqSvc, "Сервис заявок депозитов (опц.)") {
  together {
    Container(app_api, "Deposit Application API", "ASP.NET Web API", "Приём заявок от ИБ/Сайта")
    Container(app_worker, "Background Worker", ".NET", "Асинхронная передача заявок в АБС, обработка статусов")
    ContainerDb(app_db, "Application DB", "MS SQL", "Заявки, outbox/интеграционные таблицы")
  }
}

System_Boundary(abs_b, "АБС") {
  together {
    Container(abs_core, "ABS Core", "PL/SQL packages", "Deposits/Contracts/CreditRisk")
    ContainerDb(abs_db, "ABS DB", "Oracle", "Счета, клиенты, депозиты, договоры")
    Container(abs_ui, "ABS Desktop (АРМ)", "Delphi", "Рабочие места фронт-/бэк-офиса")
  }
}

System_Boundary(cc, "Кол-центр / CRM") {
  together {
    Container(crm_ui, "CRM Web UI", "React", "Интерфейс оператора")
    Container(crm_be, "CRM Backend", "Java Spring Boot", "Обращения/лиды, интеграции")
    ContainerDb(crm_db, "CRM DB", "PostgreSQL", "Заявки/кейсы")
  }
}

' === ВНЕШНИЕ СИСТЕМЫ ===
together {
  Container_Ext(sms, "СМС-шлюз", "Внешний провайдер", "Отправка SMS уведомлений")
  Container_Ext(excel, "Excel (ставки)", "XLS", "Ручной расчёт/хранение ставок")
}

' === ВЗАИМОДЕЙСТВИЯ ===

' Пользователи → каналы
Rel(newClient, web, "Выбор депозита, подача заявки", "HTTPS/TLS")
Rel(existingClient, ib_ui, "Просмотр/подача заявки, СМС-подтверждение", "HTTPS/TLS")
Rel(operCC, crm_ui, "Работа с обращениями", "")

' Взаимодействия внутри ИБ
Rel(ib_ui, ib_be, "HTTP")
Rel(ib_be, ib_db, "SQL")

' ИБ → СМС (подтверждение операции)
Rel(ib_be, sms, "Отправка/проверка СМС-кода", "SMS API/TLS")

' Сайт → CRM
Rel(web, crm_be, "Создание лида/обращения", "REST/TLS")
Rel(crm_be, crm_db, "Чтение/запись", "SQL")

' ИБ → Сервис заявок (опционально) → АБС
Rel(ib_be, app_api, "Передача заявки", "REST/TLS")
Rel(app_api, app_db, "Чтение/запись", "SQL")
Rel(app_db, app_worker, "Outbox poll", "SQL")
Rel(app_worker, abs_core, "Создание/обновление заявки", "Integration call/PROC")

' Альтернатива без сервиса заявок (закомментируй опциональный слой и раскомментируй связь ниже)
' Rel(ib_be, abs_core, "Передача заявки (избегать прямых вызовов в будущем)", "REST/PROC/TLS")

' CRM ↔ АБС (как есть)
Rel(crm_be, abs_core, "Создание/уточнение заявки", "Интеграция (существующая)")

' АБС ↔ Excel (ручной/батч)
Rel(abs_core, excel, "Импорт/экспорт ставок", "ручной обмен файлами")

' АБС → СМС-гейт → Клиенты
Rel(abs_core, sms, "Уведомления о ставке/открытии", "SMS API/TLS")
Rel(sms, newClient, "SMS", "")
Rel(sms, existingClient, "SMS", "")

' ABS Core ↔ ABS DB
Rel(abs_core, abs_db, "Чтение/запись", "SQL")

' CRM UI ↔ CRM Backend
Rel(crm_ui, crm_be, "REST/HTTPS")

@enduml